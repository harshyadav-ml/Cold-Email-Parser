# ── SMTP (fallback delivery) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SENDER_NAME=Your Name

# ── Feature Flags ────────────────────────────────────────────────────
DRY_RUN=true
SEND_METHOD=gmail_api
MAX_SENDS_PER_SESSION=50

# ── LLM ─────────────────────────────────────────────────────────────
LLM_ENABLED=false
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Gmail API OAuth (Render cloud deployment) ────────────────────────
# Paste the full contents of token.json as a single-line JSON string
GMAIL_TOKEN_JSON=

# ── CORS (Render backend → Vercel frontend) ──────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
